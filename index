    function resetAllData() {
      if (!confirm('確定要清空所有人員名單與消費記錄嗎？')) return;
      appState = {
        members: [],
        expenses: []
      };
      itemizedList = [];
      percentShares = {};
      mahjongScores = {};
      recordHistory();
      renderAllViews();
      showToast('所有資料已重置清空', '🧹');
    }

    // --- STREAMING_CHUNK:Attaching event listeners and keyboard shortcuts ---
    function initEventBindings() {
      // 表單與成員監聽
      DOM.formAddMember.addEventListener('submit', e => {
        e.preventDefault();
        addMember(DOM.inputMemberName.value);
      });

      // 模式 Tab 切換
      DOM.tabs.equal.addEventListener('click', () => switchMode('equal'));
      DOM.tabs.percent.addEventListener('click', () => switchMode('percent'));
      DOM.tabs.itemized.addEventListener('click', () => switchMode('itemized'));
      DOM.tabs.mahjong.addEventListener('click', () => switchMode('mahjong'));

      // 金額與稅費動態輸入
      DOM.inputTotalAmount.addEventListener('input', () => {
        if (currentMode === 'itemized') updateTaxReverseCalculation();
        validateCurrentForm();
      });

      DOM.inputFixedTax.addEventListener('input', () => {
        updateTaxReverseCalculation();
        validateCurrentForm();
      });

      DOM.selectPayer.addEventListener('change', () => validateCurrentForm());
      DOM.expenseTitle.addEventListener('input', () => validateCurrentForm());

      // 模式 1 快捷
      DOM.btnEqualAll.addEventListener('click', () => {
        DOM.equalCheckboxesContainer.querySelectorAll('input').forEach(i => i.checked = true);
        validateCurrentForm();
      });
      DOM.btnEqualNone.addEventListener('click', () => {
        DOM.equalCheckboxesContainer.querySelectorAll('input').forEach(i => i.checked = false);
        validateCurrentForm();
      });

      // 模式 3 快捷
      DOM.btnAddItemRow.addEventListener('click', () => addItemRow());
      DOM.btnSyncTotalFromItems.addEventListener('click', () => syncTotalFromItems());

      // 模式 4 麻將
      DOM.mahjongTableFee.addEventListener('input', () => validateCurrentForm());
      DOM.mahjongFeePayer.addEventListener('change', () => validateCurrentForm());
      document.querySelectorAll('input[name="mahjong-fee-split"]').forEach(r => {
        r.addEventListener('change', () => validateCurrentForm());
      });

      // 送出開銷按鈕
      DOM.btnSubmitExpense.addEventListener('click', () => submitExpense());

      // 歷史操作 Undo / Redo
      DOM.btnUndo.addEventListener('click', undo);
      DOM.btnRedo.addEventListener('click', redo);

      // 全域鍵盤快捷鍵 (Ctrl+Z / Cmd+Z, Ctrl+Y / Cmd+Y)
      window.addEventListener('keydown', e => {
        const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
        const ctrlKey = isMac ? e.metaKey : e.ctrlKey;

        if (ctrlKey && !e.shiftKey && e.key.toLowerCase() === 'z') {
          e.preventDefault();
          undo();
        } else if ((ctrlKey && e.key.toLowerCase() === 'y') || (ctrlKey && e.shiftKey && e.key.toLowerCase() === 'z')) {
          e.preventDefault();
          redo();
        }
      });

      // 複製與範例工具
      DOM.btnCopyLineReport.addEventListener('click', copyLineSettlementReport);
      DOM.btnLoadDemo.addEventListener('click', loadSampleData);
      DOM.btnResetAll.addEventListener('click', resetAllData);
    }

    // 應用程式初始化入口
    window.addEventListener('DOMContentLoaded', () => {
      loadFromLocalStorage();
      initEventBindings();
      renderAllViews();
    });
  </script>
