    // --- STREAMING_CHUNK:Generating formatted LINE report with fallback copy ---
    function copyLineSettlementReport() {
      const { balances, transactions } = computeSettlement();
      if (appState.expenses.length === 0) {
        showToast('目前尚無任何消費記錄可匯出！', '⚠️');
        return;
      }

      const totalSpent = appState.expenses.reduce((s, e) => s + (e.amount || 0), 0);

      let text = `📢 【費用分攤達人 v1.2.0 - 結算報告】\n`;
      text += `📅 結算時間：${new Date().toLocaleDateString()} ${new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}\n`;
      text += `💰 總計登記開銷：NT$ ${totalSpent.toLocaleString()} (${appState.expenses.length} 筆)\n\n`;

      text += `--- 📊 個人收支淨額 ---\n`;
      Object.entries(balances).forEach(([name, bal]) => {
        if (bal > 0.05) text += `• ${name}：應收 NT$ ${bal.toLocaleString()}\n`;
        else if (bal < -0.05) text += `• ${name}：應付 NT$ ${Math.abs(bal).toLocaleString()}\n`;
        else text += `• ${name}：平帳 (NT$ 0)\n`;
      });

      text += `\n--- 🚀 最簡轉帳方案 (${transactions.length} 筆搞定) ---\n`;
      if (transactions.length === 0) {
        text += `完全平帳，大家都不用轉帳！🥳\n`;
      } else {
        transactions.forEach(t => {
          text += `👉 ${t.from} 轉給 ${t.to}：NT$ ${t.amount.toLocaleString()}\n`;
        });
      }

      text += `\n✨ 由「費用分攤達人」自動對沖結算`;

      // 剪貼簿相容機制
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(() => {
          showToast('已複製 LINE 報告至剪貼簿！', '📋');
        }).catch(() => fallbackCopyText(text));
      } else {
        fallbackCopyText(text);
      }
    }

    function fallbackCopyText(text) {
      const textArea = document.createElement("textarea");
      textArea.value = text;
      textArea.style.position = "fixed";
      textArea.style.left = "-9999px";
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      try {
        document.execCommand('copy');
        showToast('已複製 LINE 報告至剪貼簿！', '📋');
      } catch (err) {
        showToast('複製失敗，請手動選取', '❌');
      }
      document.body.removeChild(textArea);
    }

    function showToast(message, icon = '✅') {
      DOM.toastIcon.textContent = icon;
      DOM.toastText.textContent = message;
      DOM.toast.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
      setTimeout(() => {
        DOM.toast.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
      }, 2400);
    }

    // --- STREAMING_CHUNK:Loading demo sample and binding global events ---
